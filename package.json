{
  "name": "avielle-rental-marketplace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate deploy && npm run seed",
    "db:deploy": "prisma migrate deploy",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components lib prisma/*.ts tests scripts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.26",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.6.2",
    "prisma": "6.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
